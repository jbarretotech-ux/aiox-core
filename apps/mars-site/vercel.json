{
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(www\\.)?skyus\\.com\\.br" }],
      "destination": "/portal/index.html"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
