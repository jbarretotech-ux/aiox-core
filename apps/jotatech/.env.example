# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Sem essas variáveis o app roda em MODO DEMO.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Apenas para a CLI (scripts/jt.mjs). NUNCA exponha no front-end nem na Vercel pública.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# URL pública do site (usada em links e SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
