# Copie para .env.local e preencha. Nunca faça commit de valores reais.

# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (obrigatório a partir da SG-1.3)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# WhatsApp Cloud API (obrigatório a partir da SG-1.4)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Speech-to-text (SG-1.5)
STT_API_KEY=

# Cobrança — Asaas / Pix Automático (SG-1.7)
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Preço do plano em centavos
PLAN_PRICE_CENTS=1990
